{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webbridge-chat",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "webbridge-chat", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "vars": {"ALLOWED_ORIGIN": "", "DAILY_LIMIT": "30"}
}
