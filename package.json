{
  "name": "webbridge-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "esbuild": "^0.25.0",
    "miniflare": "^5.20260910.0-alpha",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.130.0"
  }
}
